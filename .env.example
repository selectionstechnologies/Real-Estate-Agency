# Copy to .env.local to override public contact details shown on the site.
# These are PUBLIC values — never put secret API keys in VITE_ variables,
# because everything prefixed with VITE_ is bundled into the browser code.
VITE_CONTACT_PHONE="+1 (305) 555-0142"
VITE_WHATSAPP_NUMBER="13055550142"
VITE_CONTACT_EMAIL="hello@luxeestate.example"

# Optional: URL of YOUR OWN backend endpoint that proxies an AI model.
# The backend holds the AI provider key; the browser only calls this URL.
# Leave empty to use the built-in rule-based demo assistant.
VITE_CHAT_API_URL=""
